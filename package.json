{
  "name": "@aibengineering/mine-ai-mcp",
  "version": "0.1.0",
  "description": "Batteries-included MCP runtime for letting AI play Minecraft.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "mine-ai-mcp": "./src/server/host.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./transport": {
      "types": "./src/server/http.ts",
      "import": "./src/server/http.ts"
    }
  },
  "files": [
    "src",
    "docs",
    "scenarios",
    "tests",
    "README.md"
  ],
  "scripts": {
    "clean": "bun -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && bunx --bun tsc -p tsconfig.build.json && bun -e \"require('node:fs').copyFileSync('src/bot-data/bot-data.sql', 'dist/bot-data/bot-data.sql')\"",
    "typecheck": "bun check -p tsconfig.check.json",
    "typecheck:scenarios": "bun check -p scenarios/tsconfig.json",
    "typecheck:tests": "bun check -p tests/tsconfig.json",
    "test": "bun run typecheck && bun run typecheck:scenarios && bun run typecheck:tests && bun test --parallel ./src ./scenarios/src ./tests",
    "evidence:capture": "bunx --bun mine-labs run tools/action-evidence/action-catalog.yaml --repeat 1",
    "evidence:render": "bun tools/action-evidence/page.ts",
    "scenarios": "bunx --bun mine-labs run tests/minecraft/scenarios --skip-tag slow --repeat forever",
    "scenarios:once": "bunx --bun mine-labs run tests/minecraft/scenarios --skip-tag slow --repeat 1",
    "scenarios:full": "bunx --bun mine-labs run tests/minecraft/scenarios --repeat 1",
    "scenarios:known-failing": "bunx --bun mine-labs run tests/minecraft/known-failing --repeat 1",
    "scenarios:spectator": "bun tests/minecraft/build-spectator-mods.ts && bunx --bun mine-labs run tests/minecraft/scenarios --spectator",
    "scenarios:tailscale": "bun tests/minecraft/build-spectator-mods.ts && bunx --bun mine-labs run tests/minecraft/scenarios --tailscale"
  },
  "engines": {
    "node": ">=24.15.0",
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "@aibengineering/minecraft-block-highlighter": "github:aibengineering/minecraft-block-highlighter#a15592231471d351550971d12d8edb1e9a647066",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "prismarine-block": "^1.23.0",
    "prismarine-chat": "^1.13.0",
    "prismarine-item": "^1.18.0",
    "vec3": "^0.1.10",
    "zod": "^4.4.3",
    "mineflayer": "github:aibengineering/mineflayer#85136409eb7bc9080cd15ce7c5c0438a50ba94f9",
    "minecraft-data": "https://github.com/aibengineering/node-minecraft-data/releases/download/mine-ai-c932f743/minecraft-data-3.116.0.tgz"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.0.1",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.0",
    "mine-labs": "github:aibengineering/mine-labs#cdca91c274cb1b4f73e8817a1287deaa189aa88b",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "minecraft-data": "https://github.com/aibengineering/node-minecraft-data/releases/download/mine-ai-c932f743/minecraft-data-3.116.0.tgz",
    "prismarine-physics": "github:aibengineering/prismarine-physics#4e972f60d67eb782a35bf9c5359ca090b9f3794f",
    "prismarine-recipe": "github:aibengineering/prismarine-recipe#542f0600f5ddf07bb16df67fa1ac06e603bd28e0",
    "mineflayer": "github:aibengineering/mineflayer#85136409eb7bc9080cd15ce7c5c0438a50ba94f9"
  }
}

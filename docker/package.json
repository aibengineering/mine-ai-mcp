{
  "name": "@aibengineering/mine-ai-mcp",
  "version": "0.1.0",
  "description": "Batteries-included MCP runtime for letting AI play Minecraft.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "mine-ai-mcp": "./src/server/host.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./transport": {
      "types": "./src/server/http.ts",
      "import": "./src/server/http.ts"
    }
  },
  "files": [
    "src",
    "docs",
    "scenarios",
    "README.md"
  ],
  "scripts": {
    "clean": "bun -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && bunx --bun tsc -p tsconfig.build.json && bun -e \"require('node:fs').copyFileSync('src/bot-data/bot-data.sql', 'dist/bot-data/bot-data.sql')\"",
    "typecheck": "bunx --bun tsc -p tsconfig.check.json --noEmit",
    "typecheck:scenarios": "bunx --bun tsc -p scenarios/tsconfig.json --noEmit",
    "test": "bun run typecheck && bun run typecheck:scenarios && bun test src scenarios/src",
    "evidence:render": "bun scenarios/src/action-evidence-page.ts",
    "scenarios": "bunx --bun mine-labs run --jobs 5 --repeat forever",
    "scenarios:client": "bunx --bun mine-labs run --client --jobs 5"
  },
  "engines": {
    "node": ">=24.15.0",
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "@aibengineering/minecraft-block-highlighter": "github:aibengineering/minecraft-block-highlighter#8fe2983f3be5fc562437d25cc8afbb715d5103c5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "mineflayer-tool": "1.2.0",
    "prismarine-block": "^1.23.0",
    "prismarine-chat": "^1.13.0",
    "prismarine-item": "^1.18.0",
    "vec3": "^0.1.10",
    "zod": "^4.4.3",
    "mineflayer": "github:aibengineering/mineflayer#9fa1140b90877a084efd988905df0c0eceaa78d0",
    "minecraft-data": "https://github.com/aibengineering/node-minecraft-data/releases/download/mine-ai-c932f743/minecraft-data-3.116.0.tgz"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.0.1",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.0",
    "mine-labs": "github:aibengineering/mine-labs#08e7c0d4c8ea12d103f25e89af287731e3546e48",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "minecraft-data": "https://github.com/aibengineering/node-minecraft-data/releases/download/mine-ai-c932f743/minecraft-data-3.116.0.tgz",
    "prismarine-physics": "github:aibengineering/prismarine-physics#56a6794611069272653b14eb078a1454633f4eb3",
    "prismarine-recipe": "github:aibengineering/prismarine-recipe#542f0600f5ddf07bb16df67fa1ac06e603bd28e0",
    "mineflayer": "github:aibengineering/mineflayer#9fa1140b90877a084efd988905df0c0eceaa78d0"
  }
}
